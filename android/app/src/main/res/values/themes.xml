<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Litv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- 播放页：全屏、无标题。
         屏幕常亮不用主题属性（windowKeepScreenOn 不是合法的 android:attr），
         在 PlayerActivity 里用 WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON 控制。 -->
    <style name="Theme.Litv.Player" parent="Theme.Litv">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

    <!-- 播放中设置弹层用：无标题、透明底、压暗背景 -->
    <style name="LitvDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <!-- 选择弹框专用：深色底 + 浅色文字。
         之前直接用系统 AlertDialog 默认主题，弹出来是白底黑字，
         和整个 app 的深色界面完全是两套东西 —— 点设置项时那种割裂感就是它。 -->
    <style name="LitvAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#FF151A21</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">#FF151A21</item>
    </style>

    <!-- 冷启动主题：只换窗口背景，逻辑与 Theme.Litv 一致。
         系统在进程启动前就画这个背景，所以点图标不会再先黑一屏。 -->
    <style name="Theme.Litv.Splash" parent="Theme.Litv">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>
</resources>
