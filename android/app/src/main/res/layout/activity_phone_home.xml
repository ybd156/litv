<?xml version="1.0" encoding="utf-8"?>
<!--
  手机端首页：单页四 Tab，不开新页面。

  播放   内嵌播放器 + 控制条 + 节目单
  频道   搜索 + 分组 chip + 频道列表（点一下就地播放，切到播放页）
  遥控器  跳 RemoteActivity（带同样的底部栏，像切页而不是跳页）
  设置   跳 SettingsActivity（同上）

  注意：XML 注释里不能出现连续两个减号，所以这里不用横线做分隔。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 播放页 -->
        <LinearLayout
            android:id="@+id/panelPlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/playHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/playName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="还没选频道"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playEngine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/videoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/black">

                <org.videolan.libvlc.util.VLCVideoLayout
                    android:id="@+id/vlcLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Exo 官方视图：内部 AspectRatioFrameLayout + SurfaceView，
                     自己处理尺寸/比例变化，全屏不需要重建播放器 -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/exoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    />

                <!-- mpv 用的裸 SurfaceView（当前不可用，保留） -->
                <SurfaceView
                    android:id="@+id/surface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/gestureTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="#CC151A21"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/playHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="去「频道」选一个台"
                    android:textColor="#66FFFFFF"
                    android:textSize="13sp" />

                <!-- 播放控件浮层：像现代播放器一样做在画面里。
                     点画面呼出，4 秒后自动隐藏，不遮挡内容。 -->


                <!-- 播放控件浮层：铺满画面 + 底部渐变。
                     点画面呼出，4 秒自动隐藏；直播/回放角标跟随显隐。 -->
                <FrameLayout
                    android:id="@+id/playerControls"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_scrim_bottom"
                    android:visibility="gone">

                <!-- 直播 / 回放 状态：跟控件一起显示，不常驻 -->
                <TextView
                    android:id="@+id/liveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_badge_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● 直播"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                    <!-- 画面中央：播放/暂停（半透明图标，不压实底圆） -->
                    <ImageView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:contentDescription="播放/暂停"
                        android:padding="14dp"
                        android:src="@drawable/ic_pause"
                        android:alpha="0.85" />

                    <!-- 投屏：右上角 -->
                    <TextView
                        android:id="@+id/btnCast"
                        style="@style/PhoneCtlSmall"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="⇱" />



                    <!-- 全屏专用：比例 / 内核 / 解码（竖屏不显示） -->
                    <LinearLayout
                        android:id="@+id/fsTools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="30dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/fsAspect"
                            style="@style/PhoneCtlPill"
                            android:text="比例 自动" />

                        <TextView
                            android:id="@+id/fsEngine"
                            style="@style/PhoneCtlPill"
                            android:text="内核 自动" />

                        <TextView
                            android:id="@+id/fsDecode"
                            style="@style/PhoneCtlPill"
                            android:text="解码 自动" />
                    </LinearLayout>

                    <!-- 右下：静音 + 全屏 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginBottom="30dp"
                        android:layout_marginEnd="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnMute"
                            style="@style/PhoneCtlSmall"
                            android:layout_marginEnd="10dp"
                            android:text="♪" />

                        <TextView
                            android:id="@+id/btnFullscreen"
                            style="@style/PhoneCtlSmall"
                            android:text="⛶" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/playNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- 播放链路：直连/中转 + 实际用的 UA，方便排查源站校验 -->
            <TextView
                android:id="@+id/playRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:textColor="#66FFFFFF"
                android:textSize="11sp" />

            <ScrollView
                android:id="@+id/epgScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/epgList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- 频道页 -->
        <LinearLayout
            android:id="@+id/panelChannel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:autofillHints="none"
                android:background="@drawable/bg_card"
                android:hint="搜频道名 / 分组"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:id="@+id/groupBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/groupChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/empty_channels"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部 Tab -->
    <LinearLayout
        android:id="@+id/bottomTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tabPlay"
            style="@style/PhoneTab"
            android:text="播放" />

        <TextView
            android:id="@+id/tabChannel"
            style="@style/PhoneTab"
            android:text="频道" />

        <TextView
            android:id="@+id/tabRemote"
            style="@style/PhoneTab"
            android:text="遥控器" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/PhoneTab"
            android:text="设置" />
    </LinearLayout>
</LinearLayout>
