<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 设置页的分区标题：扁平风格用「小号 + 次级灰 + 字距」，靠层级而不是靠颜色抢眼 -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 设置行：整行可聚焦，焦点描边 + 放大，TV 上远处也能看清 -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:background">@drawable/bg_setting_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">18dp</item>
        <!-- 这里原来没写字号，17 处复用的设置行全都继承主题默认的 14sp，
             电视上 3 米外基本看不清。 -->
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 手机端底部 Tab：图标在上、文字在下，选中只靠颜色（扁平导航栏的做法） -->
    <style name="PhoneTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 手机端分组 chip：扁平胶囊，选中态用实底青（代码里换 drawable） -->
    <style name="GroupChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/bg_pill_surface</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">7dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
    <!-- 手机遥控按键：扁平方块（实心浅面 + 轻涟漪），不再是圆角卡片 -->
    <style name="RemoteKey">
        <item name="android:layout_width">74dp</item>
        <item name="android:layout_height">74dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/bg_key_flat</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="RemoteKeyAccent" parent="RemoteKey">
        <item name="android:background">@drawable/bg_focusable</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 手机播放页控制按钮 -->
    <!-- 播放控件三档：普通图标 / 大号播放键 / 角落小图标 -->
    <style name="PhoneCtl">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_ctl_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PhoneCtlBig">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_ctl_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 画面中间的播放/暂停：无实心底，半透明白色大图标（现代播放器做法） -->
    <style name="PhoneCtlGhost">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#D9FFFFFF</item>
        <item name="android:textSize">30sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PhoneCtlPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_badge_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PhoneCtlSmall">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_ctl_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 画面浮层图标按钮：44dp 圆形，和回看控制条、底部导航同一套视觉。
         以前这里是 ⏮ ⏭ ♪ ⛶ 这类文字符号，系统字体一变就前后不一致；
         统一换成矢量图标后，直播与回看两种状态下按钮长得一样。 -->
    <style name="PhoneCtlIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_ctl_circle</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">#FFFFFFFF</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 服务器地址分框：每段 IP / 端口一个小框 -->
    <style name="AddrBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_focusable</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:autofillHints">none</item>
        <item name="android:selectAllOnFocus">true</item>
    </style>

    <!-- IP 段之间的分隔符（. 和 :） -->
    <style name="AddrDot">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 四列浮层最左侧的图标/文字栏 -->
    <style name="RailItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_focusable</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 右侧设置菜单的一项 -->
    <!-- 设置菜单项。
         原来每项都套 bg_focusable（圆角卡片 + 3dp 描边），加上 3dp 外边距，
         九个项看起来是九个互不相干的盒子——这就是"割裂感"的来源。
         现在：透明底、项与项之间没有空隙、只有焦点那行浮出浅底，
         整列是一块连续面板；文字右对齐（参考常见 TV 客户端的设置页）。 -->
    <style name="SettingsMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">11dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <!-- 左对齐 + 焦点项文字变蓝（参考实现：不加底色块，只改文字颜色） -->
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textColor">@color/settings_item_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <!-- 解锁键盘上的一个键（儿童锁）。96×64dp：电视上 3 米外按得住，
         手机横屏也不会太挤；焦点描边复用 bg_focusable。 -->
    <style name="PinKey">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_focusable</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
