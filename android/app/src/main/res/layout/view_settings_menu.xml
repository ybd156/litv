<?xml version="1.0" encoding="utf-8"?>
<!--
  播放中呼出的右侧设置菜单（对齐参考实现的图3）：

    线路选择 / 画面比例 / 解码方式 / 超时换源 / 分类管理
    列表配置 / 显示设置 / 偏好设置 / 其他设置

  从右侧滑出，改完继续看，不离开画面。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsMenu"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="#E6080C10"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:visibility="gone">


    <!-- 一级只放 4 组。原来 9 条平铺：遥控器要按很多下才能摸到目标，
         而且「画面比例」和「显示设置」看不出是两回事。
         具体选项进二级（见 PlayerActivity 的 miPicture / miPlayback / miSettings）。 -->
    <TextView
        style="@style/SettingsMenuItem"
        android:id="@+id/miLine"
        android:text="线路" />

    <TextView
        style="@style/SettingsMenuItem"
        android:id="@+id/miPicture"
        android:text="画面" />

    <TextView
        style="@style/SettingsMenuItem"
        android:id="@+id/miPlayback"
        android:text="播放" />

    <TextView
        style="@style/SettingsMenuItem"
        android:id="@+id/miSettings"
        android:text="设置" />
</LinearLayout>
