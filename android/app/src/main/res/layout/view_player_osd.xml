<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页信息条。对齐参考实现（图1）的布局：

    左下：台标 | 台号 | 台名 | [FHD][立体声][IPV4][线路1/1]
          15:50-16:38  岁月有情时(21)
          16:38-17:31  岁月有情时(22)
    右下：中国IPTV / 0.12MB/s
    右上：16:36 周六

  浮在画面上，底部用渐变让文字压得住亮画面。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 右上：时间 + 星期 -->
    <TextView
        android:id="@+id/osdClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="40dp"
        android:textColor="#E6FFFFFF"
        android:textSize="20sp" />

    <!-- 底部整条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd_gradient"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- 左：台标 + 台号/台名/标签 + 节目 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/osdLogo"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/osdNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/osdName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/osdTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 当前节目 -->
            <TextView
                android:id="@+id/osdNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- 下一个节目 -->
            <TextView
                android:id="@+id/osdNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 右：应用名 + 实时网速 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LITV"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/osdSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
