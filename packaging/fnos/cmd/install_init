#!/bin/bash
# =============================================================================
# 安装前检查（应用文件落地之前执行）
#
# 这里只做"能不能装"的前置校验，不碰数据目录——此时 target/ 还没解包，
# 也还没有 var/、etc/。原则：宁可放过（exit 0），因为框架在安装失败时给出的
# 提示不如应用中心自己的报错清楚；真正致命的问题留给 install_callback。
# =============================================================================

set -u

log() { echo "[install_init] $1"; }

# 1. 系统架构是否在支持范围（只提示，不阻断：平台字段已经由框架筛过一次）
ARCH="$(uname -m)"
case "${ARCH}" in
    x86_64 | amd64 | aarch64 | arm64) ;;
    *) log "提示: 当前架构 ${ARCH} 未在官方支持列表内，安装后可能无法运行" ;;
esac

# 2. 最低系统版本提示（os_min_version=1.1.3100，统一网关所需）
if [ -n "${TRIM_SYS_VERSION:-}" ]; then
    log "系统版本 ${TRIM_SYS_VERSION}，架构 ${ARCH}"
fi

exit 0
