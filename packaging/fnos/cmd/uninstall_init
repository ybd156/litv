#!/bin/bash
# =============================================================================
# 卸载前：先停服务，再让框架去删文件
# 停不干净的话，残留进程会继续持有 app.sock 与数据库文件句柄，
# 卸载后表现为"应用没了但端口还占着 / 数据目录删不掉"。
# =============================================================================

set -u
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "[uninstall_init] 卸载前停止服务"
if [ -f "${SCRIPT_DIR}/main" ]; then
    bash "${SCRIPT_DIR}/main" stop || echo "[uninstall_init] 警告: 停止服务返回非 0，继续卸载"
fi

exit 0
