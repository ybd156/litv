<?xml version="1.0" encoding="utf-8"?>
<!--
  手机端首页：单页四 Tab，不开新页面。

  播放   内嵌播放器 + 控制条 + 节目单
  频道   搜索 + 分组 chip + 频道列表（点一下就地播放，切到播放页）
  遥控器  跳 RemoteActivity（带同样的底部栏，像切页而不是跳页）
  设置   跳 SettingsActivity（同上）

  注意：XML 注释里不能出现连续两个减号，所以这里不用横线做分隔。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 播放页 -->
        <LinearLayout
            android:id="@+id/panelPlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/playHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/playName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:text="还没选频道"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playEngine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_surface"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/videoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/black">

                <!-- 视频输出只有一个目标：这个 SurfaceView。
                     Exo / VLC / mpv 都往它上面画，比例由外层 AspectRatioFrameLayout
                     按设置里的选项（auto/zoom/fill/16:9/4:3）处理。 -->
                <androidx.media3.ui.AspectRatioFrameLayout
                    android:id="@+id/videoAspect"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false">

                    <SurfaceView
                        android:id="@+id/surface"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false" />

                    <!-- VLC 也放进这个比例容器：否则它 match_parent 会量到
                         整屏高度（实测 1220x2268），画面被拉伸，而且每次
                         尺寸变化都要重建 vout。 -->
                    <org.videolan.libvlc.util.VLCVideoLayout
                        android:id="@+id/vlcLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:clickable="false"
                        android:focusable="false" />
                </androidx.media3.ui.AspectRatioFrameLayout>

                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/gestureTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="#CC151A21"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/playHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="去「频道」选一个台"
                    android:textColor="#66FFFFFF"
                    android:textSize="13sp" />

                <!-- 播放控件浮层：像现代播放器一样做在画面里。
                     点画面呼出，4 秒后自动隐藏，不遮挡内容。 -->


                <!-- 播放控件浮层：铺满画面 + 底部渐变。
                     点画面呼出，4 秒自动隐藏；直播/回放角标跟随显隐。 -->
                <FrameLayout
                    android:id="@+id/playerControls"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_scrim_bottom"
                    android:visibility="gone"
                    android:elevation="12dp">

                <!-- 直播 / 回放 状态：跟控件一起显示，不常驻 -->
                <TextView
                    android:id="@+id/liveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_surface"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="● 直播"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                    <!-- 画面中央：播放/暂停。和其他浮层按钮同一套圆形底，
                         亮画面下也看得清（纯白图标在雪景里会糊掉）。 -->
                    <ImageView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_ctl_circle"
                        android:contentDescription="播放/暂停"
                        android:padding="18dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_pause"
                        android:tint="#FFFFFFFF" />

                    <!-- 上一频道 / 下一频道：贴在画面左右边缘。
                         竖屏与全屏共用这一层浮层，所以两处都会出现。
                         回看时会整组隐藏（切台等于退出回看）。 -->
                    <ImageView
                        android:id="@+id/btnPrevCh"
                        style="@style/PhoneCtlIcon"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="10dp"
                        android:contentDescription="上一频道"
                        android:src="@drawable/ic_skip_prev" />

                    <ImageView
                        android:id="@+id/btnNextCh"
                        style="@style/PhoneCtlIcon"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="下一频道"
                        android:src="@drawable/ic_skip_next" />

                    <!-- 右上角：投屏 / 静音 / 全屏。三个圆按钮排一行，
                         让出画面底部整条给回看控制条（回看时底部只放一条，
                         不再和静音/全屏抢位置）。 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnCast"
                            style="@style/PhoneCtlIcon"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="投屏"
                            android:src="@drawable/ic_cast" />

                        <ImageView
                            android:id="@+id/btnMute"
                            style="@style/PhoneCtlIcon"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="静音"
                            android:src="@drawable/ic_volume_up" />

                        <ImageView
                            android:id="@+id/btnFullscreen"
                            style="@style/PhoneCtlIcon"
                            android:contentDescription="全屏"
                            android:src="@drawable/ic_fullscreen" />
                    </LinearLayout>



                    <!-- 全屏专用：比例 / 内核 / 解码（竖屏不显示） -->
                    <LinearLayout
                        android:id="@+id/fsTools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/bg_ctl_bar"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/fsAspect"
                            style="@style/PhoneCtlPill"
                            android:text="比例 自动" />

                        <TextView
                            android:id="@+id/fsEngine"
                            style="@style/PhoneCtlPill"
                            android:text="内核 自动" />

                        <TextView
                            android:id="@+id/fsDecode"
                            style="@style/PhoneCtlPill"
                            android:text="解码 自动" />
                    </LinearLayout>

                    <!-- 回看控制条：只有回看/时移时才显示，跟控件浮层一起显隐。
                         贴画面底部（静音/全屏已移到右上角），不再压在中间挡住画面。 -->
                    <include
                        layout="@layout/view_replay_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- 竖屏回看只留这一条：一块大卡片会把竖屏画面压掉一半。
                         全屏（横屏）才用上面那条完整控制条，两者互斥显示。 -->
                    <LinearLayout
                        android:id="@+id/replaySlim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_panel_flat"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/rsPlay"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="暂停或继续"
                                android:padding="3dp"
                                android:src="@drawable/ic_pause"
                                android:tint="@color/text_primary" />

                            <TextView
                                android:id="@+id/rsClock"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="00:00 / --:--"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/rsLive"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?android:attr/selectableItemBackground"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="回到直播"
                                android:textColor="@color/accent"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/rsProgress"
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:layout_marginTop="2dp"
                            android:max="1000"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:progressDrawable="@drawable/progress_flat"
                            android:splitTrack="false"
                            android:thumb="@drawable/thumb_dot"
                            android:thumbOffset="0dp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- 视频下方信息区（扁平化）：不用卡片、不用阴影，靠字号与明度分层。
                 第一行 强调色小胶囊 + 16sp 节目名；第二行 4dp 细进度 + 百分比；
                 第三行下一档（次要色）；第四行播放链路（最弱，仅排障用）。 -->
            <LinearLayout
                android:id="@+id/playInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/playNowTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_accent"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="正在播"
                        android:textColor="@color/bg"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/playNow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 当前节目进度：跟「正在播」一起出现（iOS 那边早就有，安卓之前只有一行标题） -->
                <LinearLayout
                    android:id="@+id/playProgressRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/playProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_flat" />

                    <TextView
                        android:id="@+id/playProgressPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 下一档节目：直播最常看的两条信息之一 -->
                <TextView
                    android:id="@+id/playNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- 播放链路：直连/中转 + 实际用的 UA，方便排查源站校验 -->
                <TextView
                    android:id="@+id/playRoute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingTop="4dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/epgScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/epgList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- 频道页 -->
        <LinearLayout
            android:id="@+id/panelChannel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:autofillHints="none"
                android:background="@drawable/bg_input_flat"
                android:hint="搜频道名 / 分组"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 源分类：和 TV 频道面板最左列同口径（全部源 / 自建源 / 内置源） -->
            <HorizontalScrollView
                android:id="@+id/sourceBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sourceChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/groupBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/groupChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/empty_channels"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部 Tab：扁平导航栏。1dp 分隔线 + 图标 + 文字，选中态只用颜色，
         不做浮起的卡片（那是旧版的割裂感来源）。整块可点，点图标也生效。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/bottomTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/itemPlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconPlay"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_play" />

            <TextView
                android:id="@+id/tabPlay"
                style="@style/PhoneTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="播放" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconChannel"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_channel" />

            <TextView
                android:id="@+id/tabChannel"
                style="@style/PhoneTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="频道" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemRemote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconRemote"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_remote" />

            <TextView
                android:id="@+id/tabRemote"
                style="@style/PhoneTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="遥控器" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_settings" />

            <TextView
                android:id="@+id/tabSettings"
                style="@style/PhoneTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="设置" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
