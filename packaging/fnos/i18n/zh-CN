# LITV 简体中文文案
# 语法：INI 风格 [section] + key="value"，无转义（值内不要出现双引号）。
# 引用方式：manifest / app/ui/config / wizard/* 里写 ${section.key}。
# 注意：fnpack 只校验"i18n 目录里必须有 en 或 en-US 文件"，不校验 key 是否存在，
#       漏写会原样显示 ${...}，所以 build.sh 里有一道引用完整性检查。

[common]
displayName="LITV 直播管理"
desc="<b>LITV</b> 是面向飞牛 fnOS 的 IPTV 直播管理后台：统一管理直播源与 EPG 节目单，给 Android TV / 手机 / iOS 客户端提供稳定的播放与鉴权接口。<br/><br/><b>⚡ 功能</b><br/>📺 直播源与频道分组管理<br/>🗓️ EPG 节目单抓取与回看<br/>🔐 设备令牌鉴权，杜绝直播源被盗链<br/>🎞️ QSV 硬件转码（可选）<br/>🌐 双入口：飞牛统一网关（免登录进管理台）+ 独立 TCP 端口（原生客户端直连）"

[entry]
title="LITV 直播管理"

[install]
stepTitle="LITV 安装配置"
helpText="LITV 需要设置一个独立服务端口（供 Android TV / 手机等原生客户端直连，管理台本身走飞牛统一网关，不占用该端口）和管理员密码。不确定端口就保持默认 28027。"
portLabel="服务端口（原生客户端直连）"
portPlaceholder="默认 28027"
portRequiredMsg="端口不能为空"
portPatternMsg="端口必须是数字（1-65535）"
passwordLabel="管理员密码"
passwordPlaceholder="至少 8 位；留空将自动生成"
passwordLengthMsg="密码长度需在 8-64 位之间"
dataDirLabel="媒体库目录（录播 / 播放列表，可留空）"
dataDirPlaceholder="例如 /vol1/litv，留空则用应用数据目录"

[config]
stepTitle="LITV 设置"
helpText="修改后的配置会立即写回配置文件并自动重启服务。不需要修改的项请留空。"
portLabel="服务端口"
portPlaceholder="留空表示不修改"
portPatternMsg="端口必须是数字（1-65535）"
passwordLabel="管理员密码"
passwordPlaceholder="留空表示不修改"
passwordLengthMsg="密码长度需在 8-64 位之间"
transcodeLabel="启用服务端转码"
transcodeHelp="开启后由 NAS 用 QSV 硬解把高码率频道转成客户端能播的格式，会占用 CPU / 核显。配置里还需 ffmpeg 可用。"

[uninstall]
stepTitle="确认卸载"
helpText="<strong>即将卸载 LITV</strong><br/><br/>卸载会停止服务并删除主程序文件。请选择如何处理数据库、配置和媒体库数据。"
dataOptionLabel="数据如何处理"
keepDataLabel="保留数据（推荐）—— 保留数据库、配置与媒体库，重装后可直接恢复"
deleteDataLabel="删除全部数据 —— 清空数据库、配置与媒体库，不可恢复"
selectionRequiredMsg="请选择数据处理方式"
