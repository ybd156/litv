{
  "name": "litv-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LITV IPTV 管理台（Vue 3 + Vite + Naive UI，部署于 /app/litv/）",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:mock": "vue-tsc --noEmit -p tsconfig.json && vite build --mode mock",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "naive-ui": "^2.40.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
