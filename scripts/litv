#!/usr/bin/env bash
# =============================================================================
# litv —— LITV 服务端的运维小命令行（版本选择 / 升级 / 回滚 / 自动升级）
#
# 安装脚本会把本文件放到 <安装目录>/litv，并软链到 /usr/local/bin/litv，
# 所以装好之后在任意目录直接敲 `litv` 就行。
#
#   litv status              容器与健康状态
#   litv version             当前跑的是哪个版本
#   litv list                列出 GHCR 上可用的版本（* 标当前，latest 标最新）
#   litv upgrade             升到最新正式版（已经是新的就什么都不做）
#   litv upgrade 0.1.25      指定版本（同时用于回滚：litv upgrade 0.1.24）
#   litv upgrade --to latest 显式跟随 latest 标签
#   litv logs [-n 100]       看日志
#   litv restart             重启容器
#   litv auto on|off         每天自动检查一次并升级（systemd timer，无 systemd 退化为 cron）
#   litv auto status         自动升级是否开着、下次什么时候跑
#
# 升级流程是「先备份编排文件 → 改 image 标签 → pull → up -d → 等健康检查」，
# 健康检查不过会自动把标签改回去、重新 up —— 不会把一个起不来的版本留在机器上。
# =============================================================================
set -euo pipefail

IMAGE_DEFAULT="ghcr.io/ybd156/litv"
DIR_DEFAULT="/opt/litv"
HEALTH_PATH="/api/v1/health"
HEALTH_TIMEOUT=90

say()  { printf '\033[36m%s\033[0m\n' "$*"; }
ok()   { printf '\033[32m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }
die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- 配置定位
# 安装脚本会写 <DIR>/.litv.conf；没有就用默认值（兼容手工搭的环境）
resolve_conf() {
  local d="${LITV_DIR:-}"
  if [ -z "$d" ] && [ -f ./.litv.conf ] && [ -f ./docker-compose.yml ]; then d="$(pwd)"; fi
  if [ -z "$d" ] && [ -n "${1:-}" ]; then d="$1"; fi
  if [ -z "$d" ]; then d="$DIR_DEFAULT"; fi
  LITV_DIR="$d"
  if [ -f "$LITV_DIR/.litv.conf" ]; then
    # shellcheck disable=SC1091
    . "$LITV_DIR/.litv.conf"
  fi
  LITV_DIR="${LITV_DIR:-$d}"
  LITV_PORT="${LITV_PORT:-28027}"
  LITV_BIND="${LITV_BIND:-0.0.0.0}"
  LITV_IMAGE="${LITV_IMAGE:-$IMAGE_DEFAULT}"
  COMPOSE="$LITV_DIR/docker-compose.yml"
  [ -f "$COMPOSE" ] || die "找不到 $COMPOSE（用 LITV_DIR=<安装目录> litv ... 指定）"
}

compose() { docker compose -f "$COMPOSE" "$@"; }

current_version() {
  # 从编排文件里取 image: 行的 tag
  sed -n 's/^[[:space:]]*image:[[:space:]]*[^:]*:\(.*\)$/\1/p' "$COMPOSE" | head -n1
}

health_ok() {
  curl -fsS -o /dev/null --max-time 3 "http://127.0.0.1:${LITV_PORT}${HEALTH_PATH}" 2>/dev/null
}

wait_healthy() {
  local i=0
  while [ "$i" -lt "$((HEALTH_TIMEOUT / 3))" ]; do
    if health_ok; then return 0; fi
    i=$((i + 1))
    sleep 3
  done
  return 1
}

# ---------------------------------------------------------------- 版本查询
# 匿名拉 tag 列表（包是 public，不需要 docker login）
fetch_tags() {
  local token
  token="$(curl -fsSL "https://ghcr.io/token?scope=repository:${LITV_IMAGE#ghcr.io/}:pull&service=ghcr.io" 2>/dev/null \
    | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
  [ -n "$token" ] || return 1
  curl -fsSL -H "Authorization: Bearer $token" \
    "https://ghcr.io/v2/${LITV_IMAGE#ghcr.io/}/tags/list" 2>/dev/null \
    | grep -o '"tags":\[[^]]*\]' \
    | tr -d '"' | sed 's/tags:\[//; s/\]//' | tr ',' '\n' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true
}

sorted_tags() { fetch_tags | sort -u -V; }

latest_tag() { sorted_tags | tail -n1; }

# $1 是否比 $2 新（语义版本，只看 x.y.z）
is_newer() {
  [ "$1" = "$2" ] && return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

# ---------------------------------------------------------------- 子命令
cmd_version() { echo "当前版本：$(current_version)"; }

cmd_status() {
  local v; v="$(current_version)"
  echo "安装目录： $LITV_DIR"
  echo "镜像版本： $v"
  echo "监听：     $LITV_BIND:$LITV_PORT -> 容器 28027"
  if health_ok; then ok "健康检查： 通过"; else warn "健康检查： 不通过"; fi
  echo
  compose ps || true
}

cmd_list() {
  local cur; cur="$(current_version)"
  local newest; newest="$(latest_tag || true)"
  local tags
  tags="$(sorted_tags || true)"
  if [ -z "$tags" ]; then
    warn "取不到版本列表（检查到 ghcr.io 的网络）"
    return 1
  fi
  echo "可用版本（${LITV_IMAGE}）："
  # 新的排前面，最多显示 15 个
  for t in $(printf '%s\n' "$tags" | sort -Vr | head -n15); do
    local mark="  "
    if [ "$t" = "$cur" ]; then mark="* "; fi
    local tail_txt=""
    if [ "$t" = "$newest" ]; then tail_txt="   <- 最新"; fi
    printf '  %s%s%s\n' "$mark" "$t" "$tail_txt"
  done
  echo "  （* = 当前版本；安装：litv upgrade <版本号>）"
}

# 把编排文件里的 image 标签换掉（保留原行的缩进与其余内容）
set_version() {
  local new="$1" tmp
  tmp="$(mktemp)"
  sed "s|^\([[:space:]]*image:[[:space:]]*\).*$|\1${LITV_IMAGE}:${new}|" "$COMPOSE" > "$tmp"
  cat "$tmp" > "$COMPOSE"
  rm -f "$tmp"
}

do_upgrade() {
  local target="${1:-}" auto="${2:-}"
  local cur; cur="$(current_version)"

  if [ -z "$target" ] || [ "$target" = "latest" ]; then
    target="$(latest_tag || true)"
    [ -n "$target" ] || die "取不到最新版本号（网络或 ghcr.io 不可达）；也可以直接指定：litv upgrade 0.1.25"
  fi

  if [ "$target" = "$cur" ]; then
    if [ "$auto" = "--auto" ]; then echo "已是最新（$cur），无需操作"; return 0; fi
    echo "当前就是 $target，无需升级"
    return 0
  fi

  if [ "$auto" = "--auto" ] && ! is_newer "$target" "$cur"; then
    echo "自动升级：远端最新是 $target，不比当前 $cur 新，跳过"
    return 0
  fi

  say "==> 升级 $cur -> $target"
  cp -f "$COMPOSE" "$COMPOSE.bak.$cur"

  set_version "$target"
  say "==> 拉镜像 ${LITV_IMAGE}:${target}"
  if ! compose pull; then
    warn "拉取失败，回滚编排文件"
    cp -f "$COMPOSE.bak.$cur" "$COMPOSE"
    return 1
  fi

  say "==> 重启容器"
  compose up -d

  say "==> 等健康检查（最多 ${HEALTH_TIMEOUT}s）"
  if wait_healthy; then
    ok "✅ 已升级到 $target"
    echo "   回滚命令：litv upgrade $cur"
    # 顺手清理 7 天前的编排备份
    find "$LITV_DIR" -maxdepth 1 -name 'docker-compose.yml.bak.*' -mtime +7 -delete 2>/dev/null || true
    return 0
  fi

  warn "⚠️  健康检查没通过，自动回滚到 $cur"
  compose logs --tail 40 || true
  set_version "$cur"
  compose up -d || true
  if wait_healthy; then
    ok "已回滚到 $cur，服务正常"
  else
    warn "回滚后健康检查仍未通过，请手工看日志：litv logs -n 100"
  fi
  return 1
}

cmd_upgrade() {
  local target="" auto=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) target="${2:-}"; shift 2 ;;
      --auto) auto="--auto"; shift ;;
      -h|--help) sed -n '3,26p' "$0"; exit 0 ;;
      -*) die "未知参数：$1" ;;
      *) target="$1"; shift ;;
    esac
  done
  do_upgrade "$target" "$auto"
}

cmd_logs() { compose logs --tail "${1:-100}" -f; }
cmd_restart() { compose restart; say "已重启"; }

# ---------------------------------------------------------------- 自动升级
UNIT_DIR="/etc/systemd/system"
UNIT_NAME="litv-upgrade"

auto_on() {
  local at="${1:-04:30}"
  local self; self="$(command -v litv || echo "$LITV_DIR/litv")"
  if command -v systemctl >/dev/null 2>&1 && [ -d "$UNIT_DIR" ]; then
    cat > "$UNIT_DIR/$UNIT_NAME.service" <<UNIT
[Unit]
Description=LITV 自动升级（每天检查 GHCR 上的新版本）
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=LITV_DIR=$LITV_DIR
ExecStart=$self upgrade --auto
UNIT
    cat > "$UNIT_DIR/$UNIT_NAME.timer" <<UNIT
[Unit]
Description=LITV 每天自动升级

[Timer]
OnCalendar=*-*-* $at:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
UNIT
    systemctl daemon-reload
    systemctl enable --now "$UNIT_NAME.timer" >/dev/null
    ok "✅ 自动升级已开启：每天 $at（带 0-10 分钟随机延迟）"
    echo "   查状态：litv auto status    关闭：litv auto off"
    return 0
  fi
  # 没有 systemd（OpenWrt 等）就退化成 cron
  command -v crontab >/dev/null 2>&1 || die "既没有 systemd 也没有 crontab，无法开启自动升级"
  local hh="${at%%:*}" mm="${at##*:}"
  ( crontab -l 2>/dev/null | grep -v "$UNIT_NAME" ; \
    echo "$((10#$mm)) $((10#$hh)) * * * LITV_DIR=$LITV_DIR $self upgrade --auto >> $LITV_DIR/auto-upgrade.log 2>&1 # $UNIT_NAME" ) | crontab -
  ok "✅ 自动升级已开启（cron）：每天 $at"
}

auto_off() {
  if command -v systemctl >/dev/null 2>&1 && [ -d "$UNIT_DIR" ]; then
    systemctl disable --now "$UNIT_NAME.timer" >/dev/null 2>&1 || true
    rm -f "$UNIT_DIR/$UNIT_NAME.service" "$UNIT_DIR/$UNIT_NAME.timer"
    systemctl daemon-reload || true
    ok "已关闭自动升级（systemd timer）"
    return 0
  fi
  if command -v crontab >/dev/null 2>&1; then
    ( crontab -l 2>/dev/null | grep -v "$UNIT_NAME" ) | crontab - || true
    ok "已关闭自动升级（cron）"
    return 0
  fi
  warn "没找到 systemd / crontab，本来也没开"
}

auto_status() {
  if command -v systemctl >/dev/null 2>&1 && systemctl list-timers --all 2>/dev/null | grep -q "$UNIT_NAME"; then
    systemctl list-timers --all | grep -E "NEXT|$UNIT_NAME"
    echo
    echo "最近一次结果："
    systemctl status "$UNIT_NAME.service" --no-pager -n 8 2>/dev/null | sed -n '1,12p' || true
    return 0
  fi
  if command -v crontab >/dev/null 2>&1 && crontab -l 2>/dev/null | grep -q "$UNIT_NAME"; then
    echo "已开启（cron）："
    crontab -l | grep "$UNIT_NAME"
    return 0
  fi
  warn "自动升级没开。开启：litv auto on"
}

cmd_auto() {
  case "${1:-status}" in
    on) shift || true; auto_on "${1:-04:30}" ;;
    off) auto_off ;;
    status|"") auto_status ;;
    *) die "用法：litv auto on|off|status [每天时间，如 04:30]" ;;
  esac
}

usage() { sed -n '3,26p' "$0"; }

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    status)  resolve_conf; cmd_status ;;
    version) resolve_conf; cmd_version ;;
    list)    resolve_conf; cmd_list ;;
    upgrade) resolve_conf; cmd_upgrade "$@" ;;
    logs)    resolve_conf; cmd_logs "${1:-100}" ;;
    restart) resolve_conf; cmd_restart ;;
    auto)    resolve_conf; cmd_auto "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "未知子命令：$sub（litv --help）" ;;
  esac
}

main "$@"
