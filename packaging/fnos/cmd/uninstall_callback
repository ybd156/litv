#!/bin/bash
# =============================================================================
# 卸载后清理
#
# 用户选择来自 wizard/uninstall 的 wizard_data_action：
#   keep   —— 保留数据库/配置/媒体库，方便重装恢复（默认）
#   delete —— 彻底删除
#
# 安全红线：绝不 rm -rf 一个"可能指向用户整个磁盘"的路径。
# 媒体库根目录来自向导输入，卸载时先过一遍白名单校验，宁可少删也不误删。
# =============================================================================

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(dirname "$SCRIPT_DIR")"

if [ -z "${TRIM_PKGVAR:-}" ]; then
    if [ -d "${APP_ROOT}/var" ]; then TRIM_PKGVAR="${APP_ROOT}/var"; else TRIM_PKGVAR="/var/apps/litv/var"; fi
fi
if [ -z "${TRIM_PKGETC:-}" ]; then
    if [ -d "${APP_ROOT}/etc" ]; then TRIM_PKGETC="${APP_ROOT}/etc"; else TRIM_PKGETC="/var/apps/litv/etc"; fi
fi

log() { echo "[uninstall_callback] $1"; }

DATA_PATH_FILE="${TRIM_PKGVAR}/wizard_data_path"
ACTION="${wizard_data_action:-keep}"

# 判断一个路径是否可以安全递归删除：
#   - 必须是绝对路径
#   - 不能是根目录、系统关键目录、存储空间根目录
#   - 至少要有 2 层（/vol1/litv 这种）
is_safe_to_remove() {
    local p="$1"
    case "${p}" in
        /*) ;;
        *) return 1 ;;
    esac
    # 去掉结尾斜杠，便于比较
    p="${p%/}"
    case "${p}" in
        "" | / | /bin | /boot | /dev | /etc | /home | /lib | /lib64 | /mnt | /opt | \
        /proc | /root | /run | /sbin | /srv | /sys | /tmp | /usr | /var | /vol* | /volume*)
            return 1
            ;;
    esac
    # 至少两级：/vol1/litv 可以，/litv 不行
    local depth
    depth=$(printf '%s' "${p}" | awk -F/ '{print NF-1}')
    [ "${depth}" -ge 2 ] || return 1
    return 0
}

# 清空一个目录的内容（不删目录本身）。
# 为什么不是 rm -rf 目录：fnOS 上 ${TRIM_PKGVAR} 是软链接
# （/var/apps/litv/var -> /vol1/@appdata/litv），对软链接 rm -rf 只会删链接，
# 真正的数据反而留在存储空间里变成垃圾。清内容才是"删干净"。
clear_dir_contents() {
    local dir="$1"
    [ -n "${dir}" ] && [ -d "${dir}" ] || return 0
    case "${dir}" in
        *litv*) ;;
        *) log "跳过（路径里没有 litv，疑似配置异常）: ${dir}"; return 0 ;;
    esac
    find "${dir}" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null \
        || log "警告: 清理 ${dir} 时部分文件删除失败"
}

case "${ACTION}" in
    delete)
        log "用户选择：彻底删除数据"

        # 1. 先删媒体库目录（用户自选路径，最危险的一步，所以带校验）
        if [ -f "${DATA_PATH_FILE}" ]; then
            LIB_ROOT=$(head -n 1 "${DATA_PATH_FILE}" 2>/dev/null | tr -d '\r\n')
            if [ -n "${LIB_ROOT}" ] && [ -d "${LIB_ROOT}" ]; then
                if is_safe_to_remove "${LIB_ROOT}"; then
                    log "删除媒体库目录: ${LIB_ROOT}"
                    rm -rf "${LIB_ROOT}" 2>/dev/null || log "警告: ${LIB_ROOT} 删除失败"
                else
                    log "跳过删除（路径不在安全白名单内，请手工确认）: ${LIB_ROOT}"
                fi
            fi
        fi

        # 2. 运行时数据（数据库/缓存/转码临时文件）
        log "清空运行时数据目录: ${TRIM_PKGVAR}"
        clear_dir_contents "${TRIM_PKGVAR}"

        # 3. 配置目录
        log "清空配置目录: ${TRIM_PKGETC}"
        clear_dir_contents "${TRIM_PKGETC}"
        ;;
    keep | *)
        log "用户选择：保留数据 (${ACTION})"
        # 只清运行时残留，数据库/配置/媒体库全部保留
        rm -f "${TRIM_PKGVAR}/litvd.pid" "${TRIM_PKGVAR}/.litvd.lock" "${TRIM_PKGVAR}/.watchdog.state" 2>/dev/null || true
        rm -f "${TRIM_PKGVAR}/litvd.log" "${TRIM_PKGVAR}/litvd.log.1" 2>/dev/null || true
        log "已保留：${TRIM_PKGVAR}（数据库/缓存）与 ${TRIM_PKGETC}（配置）"
        ;;
esac

log "卸载清理完成"
exit 0
