<?xml version="1.0" encoding="utf-8"?>
<!--
  手机竖屏播放页。

  自上而下（用户指定的顺序）：
    1. 当前频道名称（+ 内核标签）
    2. 视频框（16:9 固定比例）
    3. 节目单（当前节目高亮，可上下翻）
    4. 菜单栏（上一台 / 频道 / 线路 / 下一台）

  为什么视频不铺满：竖屏全屏时 16:9 画面只占中间一条，上下全是黑边，
  手势区也被黑边吃掉。收到 16:9 之后，下面正好用来放节目单。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 1. 频道名称 -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/osdName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/osdEngine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/accent"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 2. 视频框（16:9） -->
    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:minHeight="120dp">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/gestureTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC151A21"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 3. 节目单 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="节目单"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/osdNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/epgScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/epgList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 4. 菜单栏 -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/btnPrev"
            style="@style/PhoneTab"
            android:text="上一台" />

        <TextView
            android:id="@+id/btnList"
            style="@style/PhoneTab"
            android:text="频道" />

        <TextView
            android:id="@+id/btnLines"
            style="@style/PhoneTab"
            android:text="线路" />

        <TextView
            android:id="@+id/btnNext"
            style="@style/PhoneTab"
            android:text="下一台" />
    </LinearLayout>
</LinearLayout>
