<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页布局层次（从下往上）：
    SurfaceView（视频）
    ImageView  snapshot（换台时盖住黑屏——TVBox 的做法，成本极低）
    ProgressBar loading
    TextView   switchTip（"正在切换…"）
    LinearLayout osd（底部信息条，默认隐藏）
    LinearLayout channelPanel（左侧频道列表，默认隐藏）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 视频输出统一契约：一个 AspectRatioFrameLayout 包住渲染目标，
         比例由代码按设置处理（auto / 16:9 / 4:3 / fill / zoom）。
         Exo / mpv 用 SurfaceView；个别老 Amlogic 盒子改用 TextureView（GPU 合成更稳）。
         不再使用 media3 的 PlayerView —— 它和裸 Surface 并存时会出现
         「同一个播放器再绑一次是空操作、新 Surface 应用不上」。 -->
    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/videoAspect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextureView
            android:id="@+id/surfaceTex"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

            <!-- VLC 需要 VLCVideoLayout 才能挂载画面；之前电视布局里没有它，
                 VlcEngine.videoLayout 恒为 null，attachViews 从不执行，
                 表现就是只有声音没有画面。 -->
            <org.videolan.libvlc.util.VLCVideoLayout
                android:id="@+id/vlcLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <ImageView
        android:id="@+id/snapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 换台转场幕布。
         为什么不直接动画面：这台电视的视频走独立硬件层，screencap /
         MediaProjection / PixelCopy 全都取不到帧，做不了「旧画面滑走」
         （那需要先有一帧静止图）。所以改成一块幕布扫过屏幕：
         换台时从切换方向滑进来盖住，新画面出来后继续朝同方向滑走，
         观感就是翻了一页。成本只有一个全屏 View 的位移动画。
         声明顺序必须在 osd 之前 —— 否则会盖住台名条。 -->
    <View
        android:id="@+id/curtain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <!-- 光有转圈不知道在等什么：配一行文字说明当前阶段。
         与 loading 同步显示/隐藏（见 PlayerActivity.showLoadingRunnable）。 -->
    <TextView
        android:id="@+id/loadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="96dp"
        android:text="正在连接…"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/switchTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="96dp"
        android:text="@string/switch_channel"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 底部信息条 -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_osd_card"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <!-- 左侧台标卡：竖跨两行节目，对齐机顶盒 OSD -->
        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="78dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_osd_logo"
            android:padding="8dp">

            <ImageView
                android:id="@+id/osdLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 台号 | 台名  +  角标 + 码率 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/osdNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:textColor="@color/accent"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#40FFFFFF" />

                <TextView
                    android:id="@+id/osdName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- 角标：引擎 / 线路，运行时动态填充 -->
                <LinearLayout
                    android:id="@+id/osdBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/osdRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/osdNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="21sp" />

            <ProgressBar
                android:id="@+id/osdProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/osdNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/osdHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="↑↓ 换台 · ← 频道列表（←→切分组）· → 设置 · OK 信息 · 数字键跳台"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 回看 / 时移控制条。
         只在可 seek 的内容上出现（内置源回看、服务端时移），直播态不显示——
         直播没有"进度"可拖，硬塞一条进度条等于骗用户。

         交互（电视遥控器）：
           · OK       显示/收起
           · ← →      快退/快进 10 秒（控制条收起时也生效）
           · ↑ ↓      在四个按钮之间移动焦点
           · OK       执行当前焦点按钮
           · BACK     收起控制条（再按一次才是退出播放页） -->
    <LinearLayout
        android:id="@+id/replayBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_osd_card"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/replayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/replayClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/accent"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/replayProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progressTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rbBack"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="132dp"
                android:paddingHorizontal="18dp"
                android:text="«  快退 30 秒"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/rbPlay"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="110dp"
                android:paddingHorizontal="18dp"
                android:text="暂停"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/rbFwd"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="132dp"
                android:paddingHorizontal="18dp"
                android:text="快进 30 秒  »"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/rbLive"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="120dp"
                android:paddingHorizontal="18dp"
                android:text="回到直播"
                android:textColor="@color/accent"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/replayHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="← → 10 秒 · ↑ ↓ 选按钮 · OK 确认 · 返回 收起"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 左侧频道列表 -->
    <!-- 频道列表浮层：图标栏 / 源分类 / 分组 / 频道列表（对齐参考实现） -->
    <!-- 频道浮层：分组 / 频道 / 节目单 三列 + 底部信息条，右侧露出视频。
         结构参考 DIYP / 群晖电视：两者都是三列，底部一条信息卡。 -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingVertical="36dp"
        android:visibility="gone">

        <!-- 上：三列。尺寸变化由 TransitionManager 统一补间 -->
        <LinearLayout
            android:id="@+id/panelColumns"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 0. 源列表（全部源 / 自建源 / 内置源）
                 自建源走服务端 /tv/play；内置源（央视频）由客户端现算地址。
                 两层分开列，用户能一眼看出这个台是怎么来的。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="180"
                android:layout_height="match_parent"
                android:background="@drawable/bg_panel_zone"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingHorizontal="0dp"
                android:paddingVertical="4dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/srcList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="8dp"
                android:background="@drawable/divider_vertical" />

            <!-- 1. 分类列表（全部 / 收藏 / 各分组）
                 之前这里是个竖排文字的 TextView，只能点一下循环切分组，
                 既看不出有哪些分类，也不知道当前在哪一类。
                 现在换成真正的列表，选中项高亮。 -->
            <!-- 四列全部按权重：屏幕多宽比例都不变，不针对某台机器的像素调。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="220"
                android:layout_height="match_parent"
                android:background="@drawable/bg_panel_zone"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:paddingHorizontal="0dp"
                android:paddingVertical="4dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grpList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="8dp"
                android:background="@drawable/divider_vertical" />

            <!-- 2. 频道列表：台号框 + 台名 + 当前节目。
                 **固定宽度**，不用 weight：节目单展开/收起时频道列不能被压缩。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="340"
                android:layout_height="match_parent"
                android:background="@drawable/bg_panel_zone"
                android:clipChildren="false"
                android:clipToOutline="false"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <!-- 参考布局里没有这一行标题：分组名左边已经显示了，
                     而「收藏」在左栏本来就是一个分组，这里再放一个按钮是重复入口。
                     整行 GONE，列表直接从顶部开始。子控件保留，代码里有引用。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/panelTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingBottom="4dp"
                        android:paddingStart="4dp"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />

                    <!-- C1：收藏入口。
                         必须是**可聚焦**控件：TV 上一切只能靠遥控器，纯装饰的
                         文字用户永远选不中（所以之前"没有收藏"）。
                         键位刻意不复用 MENU（已是设置菜单）与长按 OK（已是选线路）。 -->
                    <TextView
                        android:id="@+id/favBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_focusable"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="☆ 收藏"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/panelList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingVertical="8dp"
                    android:scrollbars="none" />

                <!-- 列表为空时的引导文案（C1）：不留学生一块空白。
                     典型场景就是"收藏"分组里一个台都没有。 -->
                <TextView
                    android:id="@+id/panelEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="16dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="8dp"
                android:background="@drawable/divider_vertical" />

            <!-- 3a. 节目单把手：收起状态只有这一条竖排文字（参考实现的样子）。
                 按右键展开成完整的节目单列。 -->
            <!-- 竖排：每个字一行，不是整体旋转 90°（旋转后是横躺的，不是竖排） -->
            <TextView
                android:id="@+id/epgHandle"
                android:layout_width="0dp"
                android:layout_weight="44"
                android:layout_height="match_parent"
                android:background="@drawable/bg_panel_zone"
                android:clipToOutline="true"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="节&#10;目&#10;单&#10;»"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <!-- 3. 节目单：时间 + 节目名 + 回看（默认收起，右键展开） -->
            <LinearLayout
                android:id="@+id/epgPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:layout_weight="464"
                android:background="@drawable/bg_panel_zone"
                android:clipToOutline="true"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <!-- C4：点它切换节目分类筛选 -->
                <!-- 节目单列的标题。去掉卡片背景和描边：它是个可点击的切换入口
                     （点一下切换"全部/分类"），但长得像按钮会抢走频道列表的注意力。
                     参考布局里这一栏只有一行小字「节目单 »」。 -->
                <!-- 左：日期选择器（周几 / 今天 / 明天…）。
                     选哪天，右边就显示哪天的节目——参考实现就是这个模型。 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/epgDayList"
                    android:layout_width="0dp"
                    android:layout_weight="92"
                    android:layout_height="match_parent"
                    android:scrollbars="none" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="8dp"
                    android:background="#26FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="372"
                    android:orientation="vertical"
                    android:paddingStart="4dp">

                    <TextView
                        android:id="@+id/epgTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingBottom="4dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="8dp"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/epgList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="none" />

                    <!-- 节目列为空时的说明：区分"还在加载"和"这个台真没节目"。
                         以前两件事都表现为一整列空白，用户只能说"节目单没了"。 -->
                    <TextView
                        android:id="@+id/epgEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>
            </LinearLayout>

            <!-- 4. 右侧留白：只在节目单展开时保留，露出正在播的画面。
                 节目单收起时这块要让出来——否则频道列和「节目单 »」把手之间
                 会空出一大片。 -->
            <!-- 右侧留白：**透明**，露出正在播的画面。
                 收起节目单时也要留着——面板不该占满整屏。 -->
            <View
                android:id="@+id/panelRightGap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="796" />
        </LinearLayout>

        <!-- 下：底部信息条（台标 / 台号名称 / 正在播 / 下一档 / 线路 / 进度 / 时间） -->
        <!-- 频道页不放底部信息条：参考实现的频道页就是纯三列，
             当前频道在列表里高亮、节目进度在节目单列里，不需要再来一条。
             之前这里有一条，看着就像 OSD 没关掉。视图保留（代码还在 setText），
             只是不显示。 -->
        <LinearLayout
            android:id="@+id/infoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B80B0E11"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/infoLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@null"
                android:padding="4dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/infoName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/infoNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/infoNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#8B949E"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="200dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/infoLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/accent"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/infoProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progressTint="@color/accent" />

                <TextView
                    android:id="@+id/infoTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 数字键跳台提示 -->
    <TextView
        android:id="@+id/numberTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="@color/bg_panel"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="@color/accent"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <include layout="@layout/view_settings_menu" />

    <!-- 冷启动开屏层：进程刚起来、还没拿到第一帧时盖在最上层。
         没有它的时候，从点图标到起播之间是纯黑，用户不知道在等什么。
         首帧到达后由 hideLoading() 淡出；换台时不会再出现（那时有幕布快照）。 -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.2"
            android:text="LITV"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="正在连接服务器…"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
