<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <!-- 手势提示：音量/亮度 -->
    <TextView
        android:id="@+id/gestureTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC151A21"
        android:paddingHorizontal="22dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 顶部 OSD -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC0B0E11"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/osdName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/osdEngine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/osdNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/osdHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="单击信息 · 双击暂停 · 上下滑换台 · 左半屏滑音量 · 右半屏滑亮度"
            android:textColor="#66FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部按钮条 -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0B0E11"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnPrev"
            style="@style/PhoneTab"
            android:text="上一台" />

        <TextView
            android:id="@+id/btnList"
            style="@style/PhoneTab"
            android:text="频道" />

        <TextView
            android:id="@+id/btnLines"
            style="@style/PhoneTab"
            android:text="线路" />

        <TextView
            android:id="@+id/btnNext"
            style="@style/PhoneTab"
            android:text="下一台" />
    </LinearLayout>
</FrameLayout>
