# Shell 脚本必须保持 LF。
#
# fnOS 是 Linux。用 CRLF 检出的 #!/bin/bash 脚本会被解释器直接拒绝：
#   bash: line 45: syntax error near unexpected token `$'{\r''
# Windows 上 core.autocrlf=true 会把仓库里的 LF 转成 CRLF，
# 打包出来的 install_callback / config_callback 就全部失效——
# 用户看到的是"装不上"，而且只在 NAS 上才会暴露。
* text=auto

*.sh                text eol=lf
packaging/fnos/**   text eol=lf
build/test/*.sh     text eol=lf

# 仓库里的 .mjs 是构建/自测脚本，跑在 CI（Linux）与本地两边。
# 混用会让每次改动都产生整文件行尾噪声（edge/scripts 里就出现过
# workertest 是 LF、selftest 是 CRLF），diff 不可读、review 也会漏看。
*.mjs               text eol=lf

# 容器部署文件：镜像构建在 Linux 上跑。
# Dockerfile 带 CRLF 时 RUN 指令尾部会多出 \r（报 `/bin/sh: 1: ...: not found`），
# 而 compose / config 里的路径也会带进看不见的字符，所以这三类一律锁 LF。
Dockerfile            text eol=lf
.dockerignore         text eol=lf
docker-compose*.yml   text eol=lf
config/*.yaml         text eol=lf

# scripts/litv 没有扩展名，但它就是个 bash 脚本，必须 LF。
# 带 CRLF 时服务器上会报 `bash: /opt/litv/litv: /usr/bin/env: bad interpreter: No such file or directory`。
scripts/litv          text eol=lf

# 二进制与图片不要参与行尾转换
*.png   binary
*.PNG   binary
*.fpk   binary
*.apk   binary
*.ipa   binary
*.db    binary
