#!/usr/bin/env bash
# =============================================================================
# gradlew —— Gradle 启动器（不依赖任何本地路径）
#
# 为什么不是标准 wrapper：
#   标准 `gradle wrapper` 会去 services.gradle.org 下载分发包，
#   国内网络下基本必失败。这里直接用环境里已有的 Gradle。
#
# 查找顺序：
#   1. $GRADLE_BIN          显式指定
#   2. $GRADLE_HOME/bin/gradle
#   3. PATH 上的 gradle     （CI 用 gradle/actions/setup-gradle 装的就是这个）
#
# CI 上其实不经过这个脚本（workflow 里直接调 `gradle`），
# 保留它是为了让本地手动跑 `./gradlew xxx` 的习惯不失效。
# =============================================================================
set -euo pipefail

if [ -n "${GRADLE_BIN:-}" ] && [ -x "${GRADLE_BIN}" ]; then
  exec "$GRADLE_BIN" "$@"
fi

if [ -n "${GRADLE_HOME:-}" ] && [ -x "${GRADLE_HOME}/bin/gradle" ]; then
  exec "${GRADLE_HOME}/bin/gradle" "$@"
fi

if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi

echo "找不到 Gradle。请任选一种：" >&2
echo "  1) 装 Gradle 到 PATH" >&2
echo "  2) export GRADLE_HOME=/path/to/gradle-8.7" >&2
echo "  3) export GRADLE_BIN=/path/to/gradle" >&2
echo "  4) 推上去让 GitHub Actions 编（见 AGENTS.md §8）" >&2
exit 1
