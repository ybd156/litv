<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页布局层次（从下往上）：
    SurfaceView（视频）
    ImageView  snapshot（换台时盖住黑屏——TVBox 的做法，成本极低）
    ProgressBar loading
    TextView   switchTip（"正在切换…"）
    LinearLayout osd（底部信息条，默认隐藏）
    LinearLayout channelPanel（左侧频道列表，默认隐藏）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/snapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <TextView
        android:id="@+id/switchTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="96dp"
        android:text="@string/switch_channel"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 底部信息条 -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 台标 -->
            <ImageView
                android:id="@+id/osdLogo"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <!-- 台号 -->
            <TextView
                android:id="@+id/osdNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/osdName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 标签：[FHD][立体声][IPV4][线路1/1] -->
            <TextView
                android:id="@+id/osdTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/osdEngine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/osdNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/osdProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/osdNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/osdHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="↑↓ 换台 · ← 频道列表(←→切分组) · → 节目单 · OK 信息 · 长按OK 切线路 · 数字键跳台 · MENU 设置"
            android:textColor="#66FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 左侧频道列表 -->
    <!-- 频道列表浮层：图标栏 / 源分类 / 分组 / 频道列表（对齐参考实现） -->
    <!-- 频道浮层：分组窄竖条 / 频道列表 / 节目单，右侧露出视频 -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <!-- 1. 分组窄竖条（参考实现里是竖排文字） -->
        <TextView
            android:id="@+id/grpStrip"
            android:layout_width="66dp"
            android:layout_height="match_parent"
            android:background="#E60B0E11"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="全部
《
频道"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- 2. 频道列表：台号框 + 台名 + 当前节目 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.40"
            android:background="#E60B0E11"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/panelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:paddingStart="4dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panelList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- 3. 节目单：星期 + 时间 + 节目名 + 回看 -->
        <LinearLayout
            android:id="@+id/epgPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.34"
            android:background="#D90B0E11"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/epgTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:paddingStart="4dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/epgList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- 4. 右侧留白，露出正在播的画面 -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.26" />
    </LinearLayout>

    

    <!-- 数字键跳台提示 -->
    <TextView
        android:id="@+id/numberTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="@color/bg_panel"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="@color/accent"
        android:textSize="32sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <include layout="@layout/view_settings_menu" />
</FrameLayout>
